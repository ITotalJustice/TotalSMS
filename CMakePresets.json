{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "sdl3",
            "displayName": "sdl3",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SDL3": true,
                "SMS_SINGLE_FILE": true
            }
        },
        {
            "name": "sdl3-debug",
            "displayName": "sdl3-debug",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SDL3": true,
                "SMS_SINGLE_FILE": true
            }
        },
        {
            "name": "sdl3-dev",
            "displayName": "sdl3-dev",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SDL3": true,
                "SMS_DEV": true
            }
        },
        {
            "name": "emsdk",
            "displayName": "emsdk",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "LTO": true,
                "SMS_SINGLE_FILE": true
            }
        },
        {
            "name": "emsdk-dev",
            "displayName": "emsdk-dev",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "EMRUN": true,
                "LTO": false,
                "SMS_SINGLE_FILE": true,
                "SMS_DEBUG": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "sdl3",
            "configurePreset": "sdl3"
        },
        {
            "name": "sdl3-debug",
            "configurePreset": "sdl3-debug"
        },
        {
            "name": "sdl3-dev",
            "configurePreset": "sdl3-dev"
        },
        {
            "name": "emsdk",
            "configurePreset": "emsdk"
        },
        {
            "name": "emsdk-dev",
            "configurePreset": "emsdk-dev"
        }
    ]
}
